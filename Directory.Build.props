<Project>
  <PropertyGroup>
    <!--
      Local and pull-request builds use a harmless development version.
      The release workflow supplies an explicit semantic version from the
      published GitHub release tag via -p:Version=<version>.
    -->
    <Version Condition="'$(Version)' == ''">0.0.0-local</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
